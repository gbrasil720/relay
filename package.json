{
  "name": "relay",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/bun": "^1.3.14",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "@trpc/client": "^11.18.0",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.23",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.2",
      "elysia": "^1.4.29"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @relay/db",
    "db:studio": "turbo run db:studio -F @relay/db",
    "db:generate": "turbo run db:generate -F @relay/db",
    "db:migrate": "turbo run db:migrate -F @relay/db",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@relay/env": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "@relay/config": "workspace:*",
    "@kubojs/config": "0.4.1",
    "@biomejs/biome": "^2.5.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
