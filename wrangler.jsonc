{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "apps/server/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "userelay.site", "custom_domain": true },
    { "pattern": "www.userelay.site", "custom_domain": true }
  ],
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "NODE_ENV": "production",
    "BETTER_AUTH_URL": "https://userelay.site",
    "CORS_ORIGIN": "https://userelay.site",
    "CLIENT_IP_HEADER": "cf-connecting-ip",
    "MILLIONSEND_FROM_EMAIL": "Relay <ola@userelay.site>"
  },
  "observability": { "enabled": true }
}
